# ==============================================================================
# SUPPORTDESK ENVIRONMENT CONFIGURATION (EXAMPLE TEMPLATE ONLY)
# Never put real passwords, API keys, or tokens in this file.
# Copy this file to '.env' for local development on your machine.
# ==============================================================================

# Application Runtime Settings
NODE_ENV=development
PORT=3000

# Local PostgreSQL + Prisma (development credentials only)
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=supportdesk_dev_password
POSTGRES_DB=supportdesk
DATABASE_URL="postgresql://supportdesk:supportdesk_dev_password@localhost:5432/supportdesk?schema=public"

# Isolated PostgreSQL instance for API integration tests (compose profile: test)
TEST_POSTGRES_USER=supportdesk_test
TEST_POSTGRES_PASSWORD=supportdesk_test_password
TEST_POSTGRES_DB=supportdesk_test
TEST_DATABASE_URL="postgresql://supportdesk_test:supportdesk_test_password@localhost:5433/supportdesk_test?schema=public"

# Authentication & Security (Replace with secure random strings locally)
JWT_SECRET="replace_with_secure_random_jwt_secret_key"
JWT_EXPIRES_IN="1d"

# Frontend / Client API URLs
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
VITE_API_BASE_URL="http://localhost:3000/api/v1"
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Gemini Integration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional: set current per-million-token prices to include cost in usage logs.
GEMINI_INPUT_COST_PER_1M_TOKENS=""
GEMINI_OUTPUT_COST_PER_1M_TOKENS=""
